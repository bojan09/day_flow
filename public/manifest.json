{
  "name": "DayFlow — Daily Planner",
  "short_name": "DayFlow",
  "description": "Your daily command center — tasks, habits, notes, goals in one calm space.",
  "start_url": "/?utm_source=pwa",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#FAFAF8",
  "theme_color": "#3B6B4B",
  "orientation": "portrait-primary",
  "id": "dayflow-planner-v1",
