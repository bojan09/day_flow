# Browser-safe values bundled into the DayFlow frontend.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
VITE_ONESIGNAL_APP_ID=YOUR_ONESIGNAL_APP_ID

# Server-only Vercel variable used by api/ai.js. Never prefix this with VITE_.
GROQ_API_KEY=YOUR_GROQ_API_KEY

# OneSignal REST credentials and CRON_SECRET do not belong in the frontend file.
# Store them with `supabase secrets set` as documented in README.md.
